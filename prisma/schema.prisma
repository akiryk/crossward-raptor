generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Puzzle {
  id        String   @id @default(cuid())
  title     String   @default("Untitled Puzzle")
  grid      Json
  hints     Json
  phase     String   @default("grid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
